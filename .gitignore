# ===================================
# CREDENTIALS AND SECRETS
# ===================================
# Environment files with API keys/secrets
config/.env
.env
.env.local
.env.production
.env.development

# BUT allow .example template files to be committed
!*.example
!**/*.example.*

# Credential scripts (contain passwords)
**/set_*_credentials.ps1
**/set_*_credentials.sh
**/credentials*.ps1
**/credentials*.sh

# BUT allow .example credential templates
!**/set_*_credentials.example.ps1
!**/set_*_credentials.example.sh

# ===================================
# PERSONAL/FINANCIAL DATA
# ===================================
# Portfolio state files (contain personal financial data)
data/state/portfolio_health.json
data/state/test_health_report.json
data/state/active_policy.json

# Order/trade history (contains transaction data)
data/archive/order_history.csv
data/archive/trade_history.csv

# ===================================
# TEST OUTPUT (may expose system paths)
# ===================================
test_output.txt
**/test_output*.txt

# ===================================
# CLAUDE CODE LOCAL SETTINGS
# ===================================
.claude/settings.local.json
.claude/projects/

# ===================================
# IBKR CLIENT PORTAL GATEWAY
# ===================================
# SSL certificates and keystores
agents/brokers/ibkr/clientportal.beta.gw/root/*.jks
agents/brokers/ibkr/clientportal.beta.gw/root/*.p12
agents/brokers/ibkr/clientportal.beta.gw/root/*.pem

# Gateway logs
agents/brokers/ibkr/clientportal.beta.gw/root/logs/
agents/brokers/ibkr/clientportal.beta.gw/*.log

