# ===================================
# TradeBot Environment Configuration
# ===================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!
#
# cp .env.example .env
# ===================================

# -----------------------------------
# OKX API Credentials (US Endpoint)
# -----------------------------------
# Get your API keys from: https://us.okx.com/account/my-api
# Required permissions: Trade, Read
#
OKX_API_KEY=your-api-key-here
OKX_SECRET_KEY=your-secret-key-here
OKX_PASSPHRASE=your-passphrase-here

# -----------------------------------
# Alpaca API Credentials (Paper Trading)
# -----------------------------------
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview
# Use PAPER trading keys only!
#
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_API_SECRET=your-alpaca-secret-key

# -----------------------------------
# Optional: CoinGlass API (Liquidation Data)
# -----------------------------------
# Get your API key from: https://www.coinglass.com/
#
# COINGLASS_API_KEY=your-coinglass-api-key
